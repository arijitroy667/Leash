# Copy to .env. Never commit .env. Never paste these values into chat.

# ---------- You provide these ----------
# Hedera portal accounts (https://portal.hedera.com), ECDSA keys, one per person.
# Agent A is created from funder 1 and agent B from funder 2, so they are separate clusters.
# Funder 3 is optional; agent C falls back to funder 1.
FUNDER_1_ACCOUNT=
FUNDER_1_KEY=
FUNDER_2_ACCOUNT=
FUNDER_2_KEY=
FUNDER_3_ACCOUNT=
FUNDER_3_KEY=

# Free key from https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=

# EVM wallets on Sepolia. The owner signs approvals in a browser wallet; only its address goes here.
LEASH_OWNER_ADDRESS=
# Holds Sepolia ETH; registers names, deploys resolvers, sets records and roles.
ENS_MANAGER_KEY=
# Any Sepolia RPC. Public ones are rate limited.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ---------- Fixed ----------
LEASH_NAMESPACE=mumbai-1
LEASH_POLICY_PROFILE=live
# The demo clock, live profile only. After changing these, restart, and set the same values on the explorer's Vercel project.
# Block length in seconds at strike 1, 2, 3. Later strikes use the last value. The values must not shrink.
LEASH_LIVE_BLOCK_SEC=60,120,300
# Real seconds in one policy day. Sets the hold (3 days), rebuttal cooldown (1 day), probation minimum (3 days) and evidence
# expiry (60 days, or twice the total of the blocks if that is longer). It must be shorter than the first block.
LEASH_LIVE_DAY_SEC=18
HEDERA_NETWORK=hedera:testnet
HEDERA_USDC=0.0.429274
FACILITATOR_URL=https://api.testnet.blocky402.com
FACILITATOR_FALLBACK_URL=https://x402.org/facilitator
MIRROR_URL=https://testnet.mirrornode.hedera.com

# ---------- Written by scripts: leave empty ----------
# pnpm wallets:create appends AGENT_A/B/C, PROBER and MERCHANT_* accounts and keys.
# pnpm ens:setup appends the merchant names and resolver addresses.
# pnpm hcs:create appends HCS_TOPIC_ID.

# Public explorer only (Vercel). It takes no keys: public addresses and names only.
# LEASH_PUBLIC=1
# LEASH_PUBLIC_NAMESPACES=mumbai-1:live,mumbai-prod:production
# PROBER_ADDRESS=0x...
